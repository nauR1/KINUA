DATABASE_URL=sqlite:///./data/app.db
ENVIRONMENT=development
# ENVIRONMENT=production exige PostgreSQL, SECURE_COOKIES=true e origens HTTPS explícitas.
# Isso verifica configuração; não configura TLS nem declara validação clínica.
STORAGE_DIR=./data/media
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_COOKIES=false
SESSION_HOURS=8
POSE_MODEL_PATH=./data/models/pose_landmarker_lite.task
MAX_VIDEO_BYTES=104857600
MAX_VIDEO_SECONDS=60
# Defina BOOTSTRAP_PASSWORD temporariamente ao executar app.seed, ou digite interativamente.
